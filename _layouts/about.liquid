---
layout: default
---
<div class="post home-page">
  <article>
    <section class="home-hero" aria-label="Introduction">
      <div class="home-hero__copy">
        {% if page.subtitle != blank %}
          <p class="home-hero__subtitle">{{ page.subtitle }}</p>
        {% endif %}

        <h1 class="home-hero__name">
          {% if site.title == 'blank' %}
            {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>

        <div class="home-hero__bio">{{ content }}</div>
      </div>

      {% if page.profile and page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <div class="home-hero__photo">
          {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 992px) 370px, 90vw" alt="Portrait of Celia Mulcahey" cache_bust=true %}
          {% if page.profile.more_info != blank %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}
    </section>

    {% if page.announcements and page.announcements.enabled %}
      <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.selected_papers %}
      <h2><a href="{{ '/publications/' | relative_url }}">Selected publications</a></h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
